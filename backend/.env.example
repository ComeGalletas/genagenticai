# Copy to backend/.env. Every value is optional; defaults live in app/config.py and app/db/settings.py.

# Ollama models (both must be pulled: `ollama pull granite4.1:8b`)
CHAT_MODEL=granite4.1:8b
JUDGE_MODEL=granite4.1:8b
EMBEDDING_MODEL=nomic-embed-text

# Context and history
#CHAT_NUM_CTX=16384
#CHAT_HISTORY_MAX_TOKENS=6000

# Retrieval
#RAG_SCORE_THRESHOLD=0.44
#RETRIEVAL_CACHE_TTL=300
#WEB_FETCH_TIMEOUT=5

# Judge
#JUDGE_MAX_RETRIES=1
#JUDGE_SKIP_MAX_CHARS=300
